---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getPostCategories } from "@/utils/getPostCategories";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { categories, uncategorized } = getPostCategories(
  await getCollection("posts")
);
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.nav.categories} | ${config.site.title}`}>
  <Header />
  <Breadcrumb />
  <Main pageTitle={t.nav.categories} pageDesc={t.pages.categoriesDesc}>
    <ul class="grid gap-3 sm:grid-cols-2">
      {
        categories.map(category => (
          <li>
            <a
              href={getRelativeLocaleUrl(locale, `categories/${category.slug}`)}
              class="border-border hover:border-accent text-accent flex items-center justify-between gap-4 rounded border px-4 py-3"
            >
              <span class="font-medium">{category.name}</span>
              <span class="text-foreground text-sm">
                {category.posts.length}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
    {
      uncategorized.length > 0 && (
        <section class="mt-8" aria-labelledby="uncategorized-heading">
          <h2 id="uncategorized-heading" class="text-xl font-semibold">
            {t.pages.uncategorizedTitle}
          </h2>
          <ul>
            {uncategorized.map(post => (
              <Card {...post} variant="h3" />
            ))}
          </ul>
        </section>
      )
    }
  </Main>
  <Footer />
</Layout>
