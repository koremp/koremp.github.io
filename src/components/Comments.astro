---
import config from "@/config";
import GitHubIcon from "@/assets/icons/socials/github.svg";

const { comments } = config.features;
const giscus = comments && comments.giscus;
const useGiscus = Boolean(giscus && giscus.repoId && giscus.categoryId);
---

{
  comments && useGiscus && (
    <section
      class="mt-8 border-t border-dashed pt-8"
      aria-labelledby="comments"
      data-pagefind-ignore
    >
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 id="comments" class="text-lg font-semibold">
          댓글
        </h2>
        <a
          class="text-muted-foreground hover:text-accent inline-flex items-center gap-1.5 text-sm underline-offset-4 hover:underline"
          href={`https://github.com/${comments.repo}/discussions`}
        >
          <GitHubIcon class="size-4" aria-hidden="true" />
          GitHub에서 보기
        </a>
      </div>
      <p class="text-muted-foreground mt-2 mb-4 text-sm leading-relaxed">
        글에 대한 생각이나 질문을 남겨주세요. GitHub 계정으로 참여할 수 있어요.
      </p>
      <github-comments
        data-repo={comments.repo}
        data-repo-id={giscus ? giscus.repoId : undefined}
        data-category={giscus ? giscus.category : undefined}
        data-category-id={giscus ? giscus.categoryId : undefined}
        class="block min-h-64"
      />
      <noscript>
        댓글을 보려면 JavaScript를 켜거나 위 GitHub 링크를 이용해 주세요.
      </noscript>
    </section>
  )
}

<script>
  class GitHubComments extends HTMLElement {
    private observer?: MutationObserver;
    private syncTheme = () => {
      const theme = this.getTheme();
      this.querySelector("iframe")?.contentWindow?.postMessage(
        { giscus: { setConfig: { theme } } },
        "https://giscus.app"
      );
    };

    private getTheme() {
      const dark = document.documentElement.dataset.theme === "dark";
      return dark ? "noborder_dark" : "noborder_light";
    }

    connectedCallback() {
      this.replaceChildren();
      const script = document.createElement("script");
      script.src = "https://giscus.app/client.js";
      script.async = true;
      script.crossOrigin = "anonymous";
      const attributes = {
        "data-repo": this.dataset.repo!,
        "data-repo-id": this.dataset.repoId!,
        "data-category": this.dataset.category!,
        "data-category-id": this.dataset.categoryId!,
        "data-mapping": "pathname",
        "data-strict": "1",
        "data-reactions-enabled": "1",
        "data-emit-metadata": "0",
        "data-input-position": "top",
        "data-theme": this.getTheme(),
        "data-lang": "ko",
        "data-loading": "lazy",
      };
      for (const [name, value] of Object.entries(attributes)) {
        if (value !== undefined) script.setAttribute(name, value);
      }
      this.append(script);

      // Also sync when the iframe finishes loading after an initial theme change.
      this.addEventListener("load", this.syncTheme, true);
      this.observer = new MutationObserver(this.syncTheme);
      this.observer.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["data-theme"],
      });
    }

    disconnectedCallback() {
      this.observer?.disconnect();
      this.removeEventListener("load", this.syncTheme, true);
    }
  }

  if (!customElements.get("github-comments")) {
    customElements.define("github-comments", GitHubComments);
  }
</script>

<style is:global>
  github-comments .giscus {
    max-width: 100%;
  }
</style>
